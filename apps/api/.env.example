# Copy this file to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=4000
# MongoDB Atlas connection string (free M0 cluster)
MONGODB_URI=
# Long random string, e.g. generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Frontend URLs allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Reverse proxies in front of the API: 0 locally, 1 on Render
TRUST_PROXY_HOPS=0
# User app address, used in links inside emails
APP_URL=http://localhost:5173
# Outgoing email for password reset. Leave SMTP_HOST empty to print emails in the terminal instead.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=your Gmail address,
# SMTP_PASS=a 16-character app password (Google Account > Security > App passwords)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=WellPath <your-address@gmail.com>
# AI providers (added in Phase 3)
GEMINI_API_KEY=
GROQ_API_KEY=
