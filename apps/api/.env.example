# Copy this file to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=4000
# MongoDB Atlas connection string (free M0 cluster)
MONGODB_URI=
# Long random string, e.g. generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Frontend URLs allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# AI providers (added in Phase 3)
GEMINI_API_KEY=
GROQ_API_KEY=
